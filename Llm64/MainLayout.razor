@inherits LayoutComponentBase

<nav class="nav-bar">
    <div class="nav-container">
        <a href="/" class="nav-brand">1000 Words</a>
        <div class="nav-links">
            <a href="/" class="nav-link">Home</a>
            <a href="/about" class="nav-link">What is this?</a>
        </div>
    </div>
</nav>

<main>
    @Body
</main>

<style>
.nav-bar {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: #2a6f7f;
    text-decoration: none;
    transition: color 0.3s;
}

.nav-brand:hover {
    color: #4a90a4;
}

.nav-links {
    display: flex;
    gap: 2rem;
}

.nav-link {
    font-size: 1rem;
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    transition: color 0.3s;
    position: relative;
}

.nav-link:hover {
    color: #4a90a4;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: #4a90a4;
    transform: scaleX(0);
    transition: transform 0.3s;
}

.nav-link:hover::after {
    transform: scaleX(1);
}

@@media (max-width: 640px) {
    .nav-container {
        padding: 1rem;
    }

    .nav-brand {
        font-size: 1.25rem;
    }

    .nav-links {
        gap: 1rem;
    }

    .nav-link {
        font-size: 0.875rem;
    }
}
</style>
